# Stripe (live keys live in .env.local; never commit live keys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Site
NEXT_PUBLIC_SITE_URL=https://aostrengthteam.store
NEXT_PUBLIC_BASE_URL=https://aostrengthteam.store

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# Meta (Facebook) Pixel + Conversions API
# All optional. The whole integration no-ops cleanly until these are set.
# Browser Pixel id. When set, the fbq base snippet loads and client events
# (PageView, ViewContent, AddToCart, InitiateCheckout, Purchase) fire.
NEXT_PUBLIC_META_PIXEL_ID=
# Server CAPI target. Use the dataset id from Events Manager (same value as the
# Pixel id for most accounts). META_DATASET_ID takes precedence if both are set.
META_PIXEL_ID=
META_DATASET_ID=
# Server CAPI access token (Events Manager -> Settings -> Conversions API).
# Required for the server-side Purchase event. Keep this secret, server-only.
META_CAPI_ACCESS_TOKEN=
# Optional. Set to the Events Manager test code to route CAPI events to the
# Test Events tab for verification before launch. Leave blank in production.
META_TEST_EVENT_CODE=
